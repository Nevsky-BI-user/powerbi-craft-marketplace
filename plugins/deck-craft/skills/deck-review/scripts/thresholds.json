{
 "schema": "deck-thresholds/1",
 "source": "references/rubric.md (single source; selftest.py asserts equality)",
 "units": {
  "canvas_pt": [960, 540],
  "canvas_px": [1280, 720],
  "px_per_pt": 1.3333333333,
  "suffixes": {
   "_pt": "pt on the 960x540 page; HTML px convert with pt = px * 0.75",
   "_px": "design px on the 1280x720 canvas",
   "_ms": "milliseconds",
   "none": "ratio, count, words or chars"
  }
 },
 "severities": ["критично", "бажано", "косметика"],
 "modes": ["talk", "reading", "talk+appendix"],
 "mode_note": "talk+appendix judges main-flow slides with talk and appendix slides with reading; a null mode block means the check does not apply in that mode",
 "measure": {
  "tol_pt": 0.5,
  "nonint_tol_pt": 0.05,
  "scale_tol_pt": 0.4,
  "silent_words_max": 5,
  "title_zone_top": 0.3,
  "pn_max_pt": 12,
  "dark_bg_max": 0.2,
  "lum_dark_max": 0.35,
  "lum_light_min": 0.6,
  "dup_hamming_max": 6,
  "per_sheet": 30,
  "ring_px": 2
 },
 "groups": {
  "dividers": ["title", "divider", "demo-divider", "appendix-divider"],
  "structural": ["title", "divider", "demo-divider", "appendix-divider", "route", "demo-still", "photo"],
  "title_exempt": ["title", "divider", "demo-divider", "appendix-divider", "route", "photo", "cta"],
  "title_box_exempt": ["title", "divider", "demo-divider", "appendix-divider", "photo"],
  "raster_exempt": ["title", "divider", "demo-divider", "appendix-divider", "photo", "demo-still", "annotated-shot"]
 },
 "tokens": {
  "classes": {
   "body": "C1.body",
   "large": "C1.large",
   "header": "C2.header",
   "ui": "G7.stroke_contrast",
   "card": "C7.card_step",
   "active": "C6.active_min",
   "dim": "C6.dim_target (info only)",
   "status": "V8.label_contrast"
  },
  "default_pairs": [
   ["ink", "surface", "body"],
   ["ink-2", "surface", "body"],
   ["ink", "surface-2", "body"],
   ["ink-2", "surface-2", "body"],
   ["accent-text", "surface", "body"],
   ["accent-text", "surface-2", "body"],
   ["on-accent", "accent-fill", "body"],
   ["link", "surface", "body"],
   ["header-ink", "header-fill", "header"],
