# .gitignore для PBIP-репозиторію.
# Інлайн-коментарі git не підтримує — '#' лише на початку рядка.
# Інакше коментар стає частиною патерну і правило мовчки перестає діяти.

# ─── Power BI Desktop: локальний стан машини ─────────────────────────────────
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.abf
*.pbix
*.pbit

# ─── Тимчасові та бекапні ────────────────────────────────────────────────────
*.bak
.bak/
*.tmp
*.lock
*~
~$*

# ─── Локальні скрипти й пісочниця ────────────────────────────────────────────
.ps1/
.py/
__pycache__/
*.pyc
_scratch/
_autodeploy/

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vs/
.vscode/

# ─── AI-інструменти ──────────────────────────────────────────────────────────
# Вміст .claude/ локальний (TEST_CASES.md з реальними ключами, чернетки),
# але settings.json — це проєктні дозволи для команди, тому повертаємо його.
# Порядок важливий: спершу виключити вміст теки, потім повернути окремий файл.
.claude/*
!.claude/settings.json
CLAUDE.local.md
# Розкоментувати, якщо CLAUDE.md має лишатись локальним (корпоративні спільні репо):
# CLAUDE.md

# ─── Секрети й персональні дані ──────────────────────────────────────────────
.env
.env.*
secrets.json
credentials.json
*_credentials*
*.key
*.pfx
TEST_CASES.md

# ─── OS ──────────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
